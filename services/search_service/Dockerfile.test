FROM python:3.11-slim

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Workspace config
COPY pyproject.toml uv.lock ./
COPY services/common ./services/common
COPY services/search_service ./services/search_service

RUN sed -i 's|\"./services/model_service\",||g; s|\"./services/document_service\",||g; s|\"./services/gateway_service\",||g; s|\"./services/user_service\",||g' pyproject.toml

# 4. Test config
COPY .env.test .env

# 5. Install
ENV PYTHONPATH=/app/services/search_service:/app/services/common

RUN uv sync --package search_service --package semantic_search_app --group dev
CMD ["sh", "-c", "uv run python -c 'from core.config import settings; print(settings.POSTGRES_URL)' && uv run pytest services/search_service/tests -v"]