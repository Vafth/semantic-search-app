pipeline {
    agent any

    stages {
        
        stage('Checkout') {
            steps {
                checkout scm
            }
        }        
        stage('Test search_service') {
            steps {
                sh '''
                    echo "=== Test raw HTTP to dind ==="
                    curl -s http://docker:2375/_ping
                    echo ""
                    echo "=== Docker info ==="
                    docker info
                '''
            }
        }
    }

    post {
        always {
            // Cleanup
            sh '''
                cd "services/search_service"
                docker-compose -f docker-compose.test.yml down -v || true
            '''
            cleanWs()
        }
    }
}