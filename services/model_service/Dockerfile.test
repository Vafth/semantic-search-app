FROM python:3.11-slim

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Workspace config
COPY pyproject.toml uv.lock ./
COPY services/common ./services/common
COPY services/model_service ./services/model_service

RUN sed -i 's|\"./services/user_service\",||g; s|\"./services/search_service\",||g; s|\"./services/gateway_service\",||g; s|\"./services/document_service\",||g' pyproject.toml

# 4. Test config
COPY .env.test .env

# 5. Install
RUN uv sync --package model_service --package semantic_search_app --group dev

CMD ["uv", "run", "pytest", "services/model_service/tests", "-v"]