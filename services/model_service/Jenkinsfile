pipeline {
    agent any

    stages {
        
        stage('Checkout') {
            steps {
                checkout scm
            }
        }        

        stage('Test model_service') {
            steps {
                sh '''
                    cd services/model_service
                    docker-compose -f docker-compose.test.yaml up --build --abort-on-container-exit
                '''
            }
        }
    }

    post {
        always {
            // Cleanup
            sh '''
                cd "services/model_service"
                docker-compose -f docker-compose.test.yml down -v || true
            '''
            cleanWs()
        }
    }
}