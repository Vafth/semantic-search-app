# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=project
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_URL=postgresql+asyncpg://admin:password@postgres:5432/project

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=secret_key
ALGORITHM=ALGORITHM
ACCESS_TOKEN_EXPIRE_MINUTES=MINUTES

# ── Internal service URLs ─────────────────────────────────────────────────────
MODEL_SERVICE_URL=http://model-service:8000
USER_SERVICE_URL=http://user-service:8001
DOCUMENT_SERVICE_URL=http://document-service:8002
SEARCH_SERVICE_URL=http://search-service:8003
GATEWAY_PORT=8080

# ── Search defaults ───────────────────────────────────────────────────────────
DEF_TOP_K=5
DEF_MIN_SCORE=0.4
DEF_MIN_DIF=0.05

# ── Document processing ───────────────────────────────────────────────────────
CHUNK_SIZE=3
CHUNK_OVERLAP=1

# ── Owner Creds ───────────────────────────────────────────────────────────────
OWNER_USERNAME=owner
OWNER_PASSWORD=password